<Window x:Class="Practice.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Управление пользователями" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Заголовки полей -->
            <RowDefinition Height="Auto" />
            <!-- Поля ввода -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки -->
            <RowDefinition Height="10" />
            <!-- Отступ снизу -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- DataGrid с настройками -->
        <DataGrid x:Name="UserDataGrid" 
           Grid.Row="0" 
           Grid.ColumnSpan="4"
           Margin="10"
           AutoGenerateColumns="False"
           CanUserAddRows="False"
           CanUserDeleteRows="False"
           SelectionMode="Single"
           SelectionUnit="FullRow"
           IsReadOnly="True"
           HorizontalScrollBarVisibility="Auto"
           SelectionChanged="UserDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding userid}" Width="Auto"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding password}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding rolename}" Width="*"/>
                <DataGridCheckBoxColumn Header="Заблокирован" Binding="{Binding isblocked}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заголовки полей ввода -->
        <Label Content="Логин" 
        Grid.Row="1" 
        Grid.Column="0" 
        HorizontalAlignment="Center" 
        Margin="0,5,0,0" 
        FontSize="14" 
        VerticalAlignment="Top"
        FontWeight="Bold"/>

        <Label Content="Пароль" 
        Grid.Row="1" 
        Grid.Column="1" 
        HorizontalAlignment="Center" 
        Margin="0,5,0,0" 
        FontSize="14" 
        VerticalAlignment="Top"
        FontWeight="Bold"/>

        <Label Content="Роль" 
        Grid.Row="1" 
        Grid.Column="2" 
        HorizontalAlignment="Center" 
        Margin="0,5,0,0" 
        FontSize="14" 
        VerticalAlignment="Top"
        FontWeight="Bold"/>

        <Label Content="Заблокировать" 
        Grid.Row="1" 
        Grid.Column="3" 
        HorizontalAlignment="Center" 
        Margin="0,5,0,0" 
        FontSize="14" 
        VerticalAlignment="Top"
        FontWeight="Bold"/>

        <!-- Поля ввода -->
        <TextBox x:Name="LoginTextBox"
          Grid.Row="2"
          Grid.Column="0"
          Margin="10,5,5,10"
          Height="30"
          VerticalContentAlignment="Center"/>

        <TextBox x:Name="PasswordTextBox"
          Grid.Row="2"
          Grid.Column="1"
          Margin="5,5,5,10"
          Height="30"
          VerticalContentAlignment="Center"/>

        <ComboBox x:Name="RoleComboBox"
           Grid.Row="2"
           Grid.Column="2"
           Margin="5,5,5,10"
           Height="30"
           DisplayMemberPath="rolename"
           SelectedValuePath="roleid"/>

        <CheckBox x:Name="IsBlockedCheckBox"
           Grid.Row="2"
           Grid.Column="3"
           Margin="5,5,10,10"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Content=""/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
             Grid.ColumnSpan="4"
             Orientation="Horizontal"
             HorizontalAlignment="Right"
             Margin="10,5,10,10">

            <Button Content="Добавить"
             Click="AddButton_Click"
             Width="100"
             Height="30"
             Margin="0,0,5,0"/>

            <Button Content="Изменить"
             Click="UpdateButton_Click"
             Width="100"
             Height="30"
             Margin="5,0,5,0"/>

            <Button Content="Удалить"
             Click="DeleteButton_Click"
             Width="100"
             Height="30"
             Margin="5,0,0,0"/>

            <Button Content="Обновить"
             Click="RefreshButton_Click"
             Width="100"
             Height="30"
             Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>