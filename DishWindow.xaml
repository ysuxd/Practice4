<Window x:Class="Practice.DishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление меню" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Заголовки полей -->
            <RowDefinition Height="Auto" />
            <!-- Поля ввода -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- DataGrid -->
        <DataGrid x:Name="DishDataGrid" 
                  Grid.Row="0" 
                  Grid.ColumnSpan="4"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  SelectionChanged="DishDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding dishid}" Width="Auto"/>
                <DataGridTextColumn Header="Название" Binding="{Binding dishname}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding categoryname}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:C}}" Width="*"/>
                <DataGridTextColumn Header="Состав" Binding="{Binding composition}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding quantity}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заголовки полей ввода -->
        <Label Content="Название" 
               Grid.Row="1" 
               Grid.Column="0" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Категория" 
               Grid.Row="1" 
               Grid.Column="1" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Цена" 
               Grid.Row="1" 
               Grid.Column="2" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Количество" 
               Grid.Row="1" 
               Grid.Column="3" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <!-- Поля ввода -->
        <TextBox x:Name="DishNameTextBox"
                 Grid.Row="2"
                 Grid.Column="0"
                 Margin="10,5,5,10"
                 Height="25"
                 VerticalContentAlignment="Center"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="categoryname"
                  SelectedValuePath="categoryid"/>

        <TextBox x:Name="PriceTextBox"
                 Grid.Row="2"
                 Grid.Column="2"
                 Margin="5,5,5,10"
                 Height="25"
                 VerticalContentAlignment="Center"/>

        <TextBox x:Name="QuantityTextBox"
                 Grid.Row="2"
                 Grid.Column="3"
                 Margin="5,5,10,10"
                 Height="25"
                 VerticalContentAlignment="Center"/>

        <!-- Дополнительные поля -->
        <Label Content="Состав" 
               Grid.Row="3" 
               Grid.Column="0" 
               Grid.ColumnSpan="4"
               HorizontalAlignment="Left" 
               Margin="10,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <TextBox x:Name="CompositionTextBox"
                 Grid.Row="3"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Margin="10,25,25,10"
                 Height="60"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,5,10,10">

            <Button Content="Добавить"
                    Click="AddButton_Click"
                    Width="100"
                    Height="30"
                    Margin="0,0,5,0"/>

            <Button Content="Изменить"
                    Click="UpdateButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Удалить"
                    Click="DeleteButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>