<Window x:Class="Practice.ClientIntefaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Столовая - Интерфейс клиента" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa">

    <Window.Resources>
        <!-- Кисти цветов колледжа -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0055a5"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#003366"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#ff6600"/>
        <SolidColorBrush x:Key="LightBrush" Color="#e6f0ff"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="GrayLightBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#555555"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4caf50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ff9800"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="ClientButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="Foreground" Value="#ffd166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#002244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок акций -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e65500"/>
                                <Setter Property="Foreground" Value="#ffd166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cc4c00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек блюд -->
        <Style x:Key="DishCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Стиль для элементов корзины -->
        <Style x:Key="CartItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBrush}"/>
            <Setter Property="BorderBrush" Value="#d1e0ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для кнопки очистки корзины -->
        <Style x:Key="ClearCartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#d32f2f"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#b71c1c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленькой кнопки добавления -->
        <Style x:Key="SmallAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#002244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки удаления -->
        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#ff4444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="Transparent"
                                CornerRadius="4"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#ff0000"/>
                                <Setter TargetName="border" Property="Background" Value="#fff0f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#f0f5ff">
        <!-- Основной контейнер -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="10"
                    Margin="0,0,0,15"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            Width="50" 
                            Height="50"
                            CornerRadius="25"
                            Padding="8">
                        <Viewbox>
                            <TextBlock Text="🍽️" 
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>

                    <!-- Информация о пользователе -->
                    <StackPanel Grid.Column="1" 
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="WelcomeText"
                                   Text="Добро пожаловать!" 
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="UserInfoText"
                                   Text="Касимовский нефтегазовый колледж" 
                                   Foreground="#ccd9ff"
                                   FontSize="14"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Статус корзины -->
                    <Border Grid.Column="2" 
                            Background="#002244"
                            CornerRadius="15"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" 
                                       Margin="0,0,5,0"
                                       Foreground="White"/>
                            <TextBlock x:Name="CartStatusText"
                                       Text="Корзина пуста" 
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: Меню -->
                <Border Grid.Column="0" 
                        Margin="0,0,10,0"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="{StaticResource GrayLightBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок меню -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource LightBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="15,10"
                                BorderBrush="#d1e0ff"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="📋 Меню столовой" 
                                           Foreground="{StaticResource SecondaryBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <ComboBox x:Name="CategoryFilterComboBox"
                                          Grid.Column="1"
                                          Width="150"
                                          Height="30"
                                          Padding="5"
                                          FontSize="13">
                                    <ComboBoxItem IsSelected="True">
                                        <TextBlock Text="Все категории"/>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Список блюд -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="10">
                            <ItemsControl x:Name="DishesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DishCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               Foreground="{StaticResource SecondaryBrush}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding Category}" 
                                                               Foreground="#666"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               Foreground="{StaticResource TextDarkBrush}"
                                                               FontSize="13"
                                                               Margin="0,5,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" 
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>

                                                    <Button Style="{StaticResource SmallAddButtonStyle}"
                                                            Margin="0,5,0,0"
                                                            Tag="{Binding Id}"
                                                            Click="AddToCartButton_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="➕" Margin="0,0,3,0"/>
                                                            <TextBlock Text="Добавить"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Правая часть: Корзина и оформление -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="{StaticResource GrayLightBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок корзины -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource LightBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="15,10"
                                BorderBrush="#d1e0ff"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="🛒 Моя корзина" 
                                       Foreground="{StaticResource SecondaryBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- Содержимое корзины -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="10">
                            <Grid>
                                <ItemsControl x:Name="CartItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CartItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" 
                                                                   Foreground="{StaticResource SecondaryBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" 
                                                                    Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text=" × " 
                                                                       Foreground="#666"/>
                                                            <TextBox Text="{Binding Quantity}" 
                                                                     Width="40"
                                                                     Height="25"
                                                                     FontSize="12"
                                                                     TextAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     PreviewTextInput="QuantityTextBox_PreviewTextInput"
                                                                     TextChanged="QuantityTextBox_TextChanged"/>
                                                            <TextBlock Text=" шт." 
                                                                       Foreground="#666"
                                                                       Margin="5,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Style="{StaticResource RemoveButtonStyle}"
                                                            Click="RemoveFromCartButton_Click"
                                                            Tag="{Binding Id}">
                                                        <TextBlock Text="🗑️"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Сообщение о пустой корзине -->
                                <TextBlock x:Name="EmptyCartText"
                                           Text="Корзина пуста. Добавьте блюда из меню."
                                           Foreground="#999"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- Итого и кнопки -->
                        <Border Grid.Row="2" 
                                Background="#f8f9fa"
                                CornerRadius="0,0,8,8"
                                Padding="15"
                                BorderBrush="#e0e0e0"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <!-- Итого -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Итого:" 
                                               Foreground="{StaticResource SecondaryBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="TotalAmountText"
                                               Grid.Column="1"
                                               Text="0 руб."
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                </Grid>

                                <!-- Кнопки управления -->
                                <StackPanel>
                                    <Button x:Name="ClearCartButton"
                                            Style="{StaticResource ClearCartButtonStyle}"
                                            Click="ClearCartButton_Click"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="Очистить корзину"/>
                                    </Button>

                                    <Button x:Name="PlaceOrderButton"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Height="45"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Click="PlaceOrderButton_Click"
                                            IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🚀" Margin="0,0,5,0"/>
                                            <TextBlock Text="Оформить заказ"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Информация -->
                                <Border Background="{StaticResource LightBrush}"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,15,0,0">
                                    <TextBlock Text="✅ Заказ будет оформлен на ваше имя и добавлен в систему"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" 
                    Background="White"
                    CornerRadius="8"
                    Margin="0,15,0,0"
                    BorderBrush="{StaticResource GrayLightBrush}"
                    BorderThickness="1">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <TextBlock Text="Столовая Касимовского нефтегазового колледжа" 
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock Text=" | " 
                                   Foreground="#999"
                                   Margin="5,0"/>
                        <TextBlock Text="Режим: Клиентский" 
                                   Foreground="#666"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="ViewOrdersButton"
                                Style="{StaticResource ClientButtonStyle}"
                                Padding="10,5"
                                FontSize="12"
                                Click="ViewOrdersButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,3,0"/>
                                <TextBlock Text="Мои заказы"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>