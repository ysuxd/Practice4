<Window x:Class="Practice.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Управление сотрудниками" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa">

    <Window.Resources>
        <!-- Кисти цветов колледжа -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0055a5"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#003366"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#ff6600"/>
        <SolidColorBrush x:Key="LightBrush" Color="#e6f0ff"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="GrayLightBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#555555"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4caf50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ff9800"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#f44336"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="CollegeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="Foreground" Value="#ffd166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#002244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource CollegeButtonStyle}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <!-- Стиль для заголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBrush}"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderBrush" Value="#d1e0ff"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Стиль для текста заголовков -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для комбобоксов и текстбоксов -->
        <Style x:Key="InputFieldStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Стиль для DataGrid -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f9f9f9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Стиль для заголовков DataGrid -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource LightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#d1e0ff"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid Background="#f0f5ff">
        <!-- Основной контейнер -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="10"
                    Margin="0,0,0,15"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            Width="50" 
                            Height="50"
                            CornerRadius="25"
                            Padding="8">
                        <Viewbox>
                            <TextBlock Text="👨‍🍳" 
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>

                    <!-- Информация -->
                    <StackPanel Grid.Column="1" 
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Управление сотрудниками" 
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Сотрудники столовой" 
                                   Foreground="#ccd9ff"
                                   FontSize="14"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Border Grid.Row="1" 
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="{StaticResource GrayLightBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица -->
                    <Border Grid.Row="0" 
                            CornerRadius="8,8,0,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#e0e0e0">
                        <DataGrid x:Name="EmployeeDataGrid" 
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  SelectionChanged="EmployeeDataGrid_SelectionChanged"
                                  HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" 
                                                    Binding="{Binding employeeid}" 
                                                    Width="60"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Фамилия" 
                                                    Binding="{Binding lastname}" 
                                                    Width="150"/>

                                <DataGridTextColumn Header="Имя" 
                                                    Binding="{Binding firstname}" 
                                                    Width="150"/>

                                <DataGridTextColumn Header="Отчество" 
                                                    Binding="{Binding surname}" 
                                                    Width="150"/>

                                <DataGridTextColumn Header="Полное имя" 
                                                    Binding="{Binding fullname}" 
                                                    Width="*"
                                                    MinWidth="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Панель управления -->
                    <Border Grid.Row="1" 
                            Background="#f8f9fa"
                            CornerRadius="0,0,8,8"
                            Padding="15"
                            BorderBrush="#e0e0e0"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Поля ввода -->
                            <Grid Grid.Row="0" 
                                  Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фамилия -->
                                <StackPanel Grid.Column="0" 
                                            Margin="0,0,10,0">
                                    <TextBlock Text="Фамилия" 
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="LastNameTextBox"
                                             Style="{StaticResource InputFieldStyle}"
                                             MaxLength="50"/>
                                </StackPanel>

                                <!-- Имя -->
                                <StackPanel Grid.Column="1" 
                                            Margin="5,0,10,0">
                                    <TextBlock Text="Имя" 
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="FirstNameTextBox"
                                             Style="{StaticResource InputFieldStyle}"
                                             MaxLength="50"/>
                                </StackPanel>

                                <!-- Отчество -->
                                <StackPanel Grid.Column="2" 
                                            Margin="5,0,0,0">
                                    <TextBlock Text="Отчество" 
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="SurnameTextBox"
                                             Style="{StaticResource InputFieldStyle}"
                                             MaxLength="50"/>
                                </StackPanel>
                            </Grid>

                            <!-- Кнопки и информация -->
                            <Border Grid.Row="1" 
                                    Background="{StaticResource LightBrush}"
                                    CornerRadius="6"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Информация -->
                                    <StackPanel Orientation="Horizontal" 
                                                VerticalAlignment="Center">
                                        <TextBlock Text="ℹ️" 
                                                   Foreground="{StaticResource SecondaryBrush}"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="Для редактирования выберите запись в таблице" 
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <!-- Кнопки -->
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="Добавить"
                                                Style="{StaticResource AddButtonStyle}"
                                                Click="AddButton_Click"
                                                ToolTip="Добавить нового сотрудника">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="➕" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Добавить"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button Content="Изменить"
                                                Style="{StaticResource UpdateButtonStyle}"
                                                Click="UpdateButton_Click"
                                                ToolTip="Изменить выбранного сотрудника">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✏️" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Изменить"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button Content="Удалить"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                Click="DeleteButton_Click"
                                                ToolTip="Удалить выбранного сотрудника">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗑️" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Удалить"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>