<Window x:Class="Practice.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Детали заказов" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa">

    <Window.Resources>
        <!-- Кисти цветов колледжа -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0055a5"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#003366"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#ff6600"/>
        <SolidColorBrush x:Key="LightBrush" Color="#e6f0ff"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="GrayLightBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#555555"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4caf50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ff9800"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#f44336"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="ViewBrush" Color="#9c27b0"/>
        <SolidColorBrush x:Key="DetailsBrush" Color="#009688"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="CollegeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="Foreground" Value="#ffd166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#002244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CollegeButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource CollegeButtonStyle}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource OperationButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewBrush}"/>
        </Style>

        <!-- Стиль для заголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBrush}"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderBrush" Value="#d1e0ff"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Стиль для текста заголовков -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для комбобоксов и текстбоксов -->
        <Style x:Key="InputFieldStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Стиль для DataGrid -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f9f9f9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GrayLightBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Стиль для заголовков DataGrid -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource LightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#d1e0ff"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid Background="#f0f5ff">
        <!-- Основной контейнер -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryBrush}"
                    CornerRadius="10"
                    Margin="0,0,0,15"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            Width="50" 
                            Height="50"
                            CornerRadius="25"
                            Padding="8">
                        <Viewbox>
                            <TextBlock Text="📋" 
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>

                    <!-- Информация -->
                    <StackPanel Grid.Column="1" 
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="WindowTitleTextBlock"
                                   Text="Детали заказов" 
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="WindowSubtitleTextBlock"
                                   Text="Управление позициями заказов" 
                                   Foreground="#ccd9ff"
                                   FontSize="14"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Статус и информация о заказе -->
                    <StackPanel Grid.Column="2" 
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Margin="10,0,0,0">

                        <!-- Информация о конкретном заказе (видна только при просмотре одного заказа) -->
                        <Border x:Name="OrderInfoBorder"
                                Background="#002244"
                                CornerRadius="15"
                                Padding="10,5"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" 
                                           Margin="0,0,5,0"
                                           Foreground="White"/>
                                <StackPanel>
                                    <TextBlock x:Name="OrderIdTextBlock" 
                                               Text="Заказ #0" 
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <TextBlock x:Name="OrderStatusTextBlock" 
                                               Text="Статус: -" 
                                               Foreground="#ccd9ff"
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Общая информация (видна всегда) -->
                        <Border Background="#004488"
                                CornerRadius="15"
                                Padding="10,5"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" 
                                           Margin="0,0,5,0"
                                           Foreground="White"/>
                                <TextBlock x:Name="ItemsCountTextBlock" 
                                           Text="Всего позиций: 0" 
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Border Grid.Row="1" 
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="{StaticResource GrayLightBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица -->
                    <Border Grid.Row="0" 
                            CornerRadius="8,8,0,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#e0e0e0">
                        <DataGrid x:Name="OrderDetailsDataGrid" 
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  SelectionChanged="OrderDetailsDataGrid_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" 
                                                    Binding="{Binding orderdetailsid}" 
                                                    Width="60"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Блюдо" 
                                                    Binding="{Binding dishname}" 
                                                    Width="150"/>

                                <DataGridTextColumn Header="Заказ" 
                                                    Binding="{Binding orderid}" 
                                                    Width="80"/>

                                <DataGridTextColumn Header="Категория" 
                                                    Binding="{Binding categoryname}" 
                                                    Width="120"/>

                                <DataGridTextColumn Header="Клиент" 
                                                    Binding="{Binding clientname}" 
                                                    Width="180"/>

                                <DataGridTextColumn Header="Сотрудник" 
                                                    Binding="{Binding employeename}" 
                                                    Width="180"/>

                                <DataGridTextColumn Header="Статус" 
                                                    Binding="{Binding statusname}" 
                                                    Width="120"/>

                                <DataGridTextColumn Header="Цена" 
                                                    Binding="{Binding price, StringFormat={}{0:0.00} ₽}" 
                                                    Width="100"/>

                                <DataGridTextColumn Header="Кол-во" 
                                                    Binding="{Binding quantity}" 
                                                    Width="80"/>

                                <DataGridTextColumn Header="Сумма" 
                                                    Width="100"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Path=., Converter={x:Static local:PriceMultiplierConverter.Instance}}"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Панель управления -->
                    <Border Grid.Row="1" 
                            Background="#f8f9fa"
                            CornerRadius="0,0,8,8"
                            Padding="15"
                            BorderBrush="#e0e0e0"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Первый ряд полей -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Блюдо -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Блюдо" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="DishComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="dishname"
                                              SelectedValuePath="dishid"/>
                                </StackPanel>

                                <!-- Заказ -->
                                <StackPanel x:Name="OrderPanel" Grid.Column="1" Margin="5,0,10,0">
                                    <TextBlock Text="Заказ" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="OrderComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="orderinfo"
                                              SelectedValuePath="orderid"/>
                                </StackPanel>

                                <!-- Категория -->
                                <StackPanel Grid.Column="2" Margin="5,0,10,0">
                                    <TextBlock Text="Категория" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CategoryComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="categoryname"
                                              SelectedValuePath="categoryid"/>
                                </StackPanel>

                                <!-- Цена -->
                                <StackPanel Grid.Column="3" Margin="5,0,10,0">
                                    <TextBlock Text="Цена" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="PriceTextBox"
                                             Style="{StaticResource InputFieldStyle}"/>
                                </StackPanel>

                                <!-- Количество -->
                                <StackPanel Grid.Column="4" Margin="5,0,0,0">
                                    <TextBlock Text="Количество" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="QuantityTextBox"
                                             Style="{StaticResource InputFieldStyle}"
                                             Text="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Второй ряд полей -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Клиент -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Клиент" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ClientComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="clientname"
                                              SelectedValuePath="clientid"/>
                                </StackPanel>

                                <!-- Сотрудник -->
                                <StackPanel Grid.Column="1" Margin="5,0,10,0">
                                    <TextBlock Text="Сотрудник" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="EmployeeComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="employeename"
                                              SelectedValuePath="employeeid"/>
                                </StackPanel>

                                <!-- Статус -->
                                <StackPanel Grid.Column="2" Margin="5,0,10,0">
                                    <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="StatusComboBox"
                                              Style="{StaticResource InputFieldStyle}"
                                              DisplayMemberPath="statusname"
                                              SelectedValuePath="statusid"/>
                                </StackPanel>

                                <!-- Кнопки -->
                                <StackPanel Grid.Column="3" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                    <Button Content="Добавить" 
                                            Style="{StaticResource AddButtonStyle}"
                                            Click="AddButton_Click"
                                            ToolTip="Добавить новую позицию">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="➕" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Добавить"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button Content="Изменить" 
                                            Style="{StaticResource UpdateButtonStyle}"
                                            Click="UpdateButton_Click"
                                            ToolTip="Изменить выбранную позицию">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏️" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Изменить"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button Content="Удалить" 
                                            Style="{StaticResource DeleteButtonStyle}"
                                            Click="DeleteButton_Click"
                                            ToolTip="Удалить выбранную позицию">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Удалить"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Информация, итоги и кнопка обновления -->
                            <Border Grid.Row="2" 
                                    Background="{StaticResource LightBrush}"
                                    CornerRadius="6"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Информация -->
                                    <StackPanel Grid.Column="0" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,15,0">
                                        <TextBlock Text="ℹ️" 
                                                   Foreground="{StaticResource SecondaryBrush}"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock x:Name="InfoTextBlock"
                                                   Text="Для редактирования выберите запись в таблице" 
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <!-- Итоговая сумма (видна только при просмотре одного заказа) -->
                                    <Border x:Name="TotalAmountBorder"
                                            Grid.Column="1" 
                                            Background="{StaticResource SuccessBrush}"
                                            CornerRadius="5"
                                            Padding="10,5"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,15,0"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰" 
                                                       Margin="0,0,5,0"
                                                       Foreground="White"/>
                                            <StackPanel>
                                                <TextBlock x:Name="TotalAmountTextBlock"
                                                           Text="Итого: 0.00 ₽" 
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                                <TextBlock x:Name="ItemsCountSummaryTextBlock"
                                                           Text="Позиций: 0" 
                                                           Foreground="#e0ffe0"
                                                           FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Кнопка назад к заказам (видна только при просмотре одного заказа) -->
                                    <Button x:Name="BackToOrdersButton"
                                            Content="← К заказам" 
                                            Style="{StaticResource ViewButtonStyle}"
                                            Click="BackToOrdersButton_Click"
                                            Grid.Column="2"
                                            MinWidth="120"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed"
                                            ToolTip="Вернуться к списку заказов">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="←" Margin="0,0,5,0"/>
                                                    <TextBlock Text="К заказам"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <!-- Кнопка обновления -->
                                    <Button Content="Обновить" 
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshButton_Click"
                                            Grid.Column="3"
                                            MinWidth="120"
                                            ToolTip="Обновить данные таблицы">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔄" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Обновить"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>