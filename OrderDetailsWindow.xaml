<Window x:Class="Practice.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказов" Height="550" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Заголовки полей -->
            <RowDefinition Height="Auto" />
            <!-- Поля ввода -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- DataGrid -->
        <DataGrid x:Name="OrderDetailsDataGrid" 
                  Grid.Row="0" 
                  Grid.ColumnSpan="4"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  SelectionChanged="OrderDetailsDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding orderdetailid}" Width="Auto"/>
                <DataGridTextColumn Header="Блюдо" Binding="{Binding dishname}" Width="*"/>
                <DataGridTextColumn Header="Заказ" Binding="{Binding orderid}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding categoryname}" Width="*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding clientname}" Width="*"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding employeename}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding statusname}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat={}{0:0.00}}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding quantity}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заголовки полей ввода -->
        <Label Content="Блюдо" 
               Grid.Row="1" 
               Grid.Column="0" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Заказ" 
               Grid.Row="1" 
               Grid.Column="1" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Цена" 
               Grid.Row="1" 
               Grid.Column="2" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Количество" 
               Grid.Row="1" 
               Grid.Column="3" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <!-- Поля ввода -->
        <ComboBox x:Name="DishComboBox"
                  Grid.Row="2"
                  Grid.Column="0"
                  Margin="10,5,5,10"
                  Height="25"
                  DisplayMemberPath="dishname"
                  SelectedValuePath="dishid"/>

        <ComboBox x:Name="OrderComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="orderinfo"
                  SelectedValuePath="orderid"/>

        <TextBox x:Name="PriceTextBox"
                 Grid.Row="2"
                 Grid.Column="2"
                 Margin="5,5,5,10"
                 Height="25"
                 VerticalContentAlignment="Center"/>

        <TextBox x:Name="QuantityTextBox"
                 Grid.Row="2"
                 Grid.Column="3"
                 Margin="5,5,10,10"
                 Height="25"
                 VerticalContentAlignment="Center"/>

        <!-- Второй ряд полей -->
        <Label Content="Категория" 
               Grid.Row="3" 
               Grid.Column="0" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Клиент" 
               Grid.Row="3" 
               Grid.Column="1" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Сотрудник" 
               Grid.Row="3" 
               Grid.Column="2" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Статус" 
               Grid.Row="3" 
               Grid.Column="3" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <!-- Поля второго ряда -->
        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="4"
                  Grid.Column="0"
                  Margin="10,5,5,10"
                  Height="25"
                  DisplayMemberPath="categoryname"
                  SelectedValuePath="categoryid"/>

        <ComboBox x:Name="ClientComboBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="clientname"
                  SelectedValuePath="clientid"/>

        <ComboBox x:Name="EmployeeComboBox"
                  Grid.Row="4"
                  Grid.Column="2"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="employeename"
                  SelectedValuePath="employeeid"/>

        <ComboBox x:Name="StatusComboBox"
                  Grid.Row="4"
                  Grid.Column="3"
                  Margin="5,5,10,10"
                  Height="25"
                  DisplayMemberPath="statusname"
                  SelectedValuePath="statusid"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,5,10,10">

            <Button Content="Добавить"
                    Click="AddButton_Click"
                    Width="100"
                    Height="30"
                    Margin="0,0,5,0"/>

            <Button Content="Изменить"
                    Click="UpdateButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Удалить"
                    Click="DeleteButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>