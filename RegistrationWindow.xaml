<Window x:Class="Practice.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация клиента" 
        Height="550"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f0f5ff">
    <!-- Убрал SizeToContent -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- Шапка -->
            <Border Background="#0055a5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Регистрация клиента" 
                               Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Столовая КНГК" 
                               Foreground="#ccd9ff" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Форма -->
            <Border Background="White" CornerRadius="8" Padding="25" BorderBrush="#e0e0e0" BorderThickness="1">
                <StackPanel>

                    <!-- Поля ввода -->
                    <StackPanel Margin="0,0,0,15">
                        <!-- Фамилия -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Фамилия:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="LastNameTextBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Имя -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="FirstNameTextBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Отчество -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Отчество:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SurnameTextBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Логин -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Логин:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="LoginTextBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Пароль -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Пароль:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Подтверждение пароля -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Повторите пароль:" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                                       VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Height="32" FontSize="13" Padding="6"/>
                        </Grid>

                        <!-- Блок сообщения об ошибке -->
                        <TextBlock x:Name="ErrorMessageTextBlock"
                                   Foreground="Red"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="RegisterButton" Content="Зарегистрироваться" 
                                MinWidth="180" Height="40" Background="#4caf50" Foreground="White"
                                FontSize="13" FontWeight="Bold" Margin="10,0" Padding="15,0"
                                Click="RegisterButton_Click"/>

                        <Button x:Name="CancelButton" Content="Отмена" 
                                MinWidth="100" Height="40" Background="#f44336" Foreground="White"
                                FontSize="13" FontWeight="Bold" Margin="10,0" Padding="15,0"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>