<Window x:Class="Practice.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление заказами" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- DataGrid -->
            <RowDefinition Height="Auto" />
            <!-- Заголовки полей -->
            <RowDefinition Height="Auto" />
            <!-- Поля ввода -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- DataGrid -->
        <DataGrid x:Name="OrderDataGrid" 
                  Grid.Row="0" 
                  Grid.ColumnSpan="4"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  SelectionChanged="OrderDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding orderid}" Width="Auto"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding clientname}" Width="*"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding employeename}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding statusname}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding orderdate, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                <DataGridTextColumn Header="Время" Binding="{Binding ordertime, StringFormat={}{0:hh\\:mm}}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заголовки полей ввода -->
        <Label Content="Клиент" 
               Grid.Row="1" 
               Grid.Column="0" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Сотрудник" 
               Grid.Row="1" 
               Grid.Column="1" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Статус" 
               Grid.Row="1" 
               Grid.Column="2" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <Label Content="Дата" 
               Grid.Row="1" 
               Grid.Column="3" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <!-- Поля ввода -->
        <ComboBox x:Name="ClientComboBox"
                  Grid.Row="2"
                  Grid.Column="0"
                  Margin="10,5,5,10"
                  Height="25"
                  DisplayMemberPath="clientname"
                  SelectedValuePath="clientid"/>

        <ComboBox x:Name="EmployeeComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="employeename"
                  SelectedValuePath="employeeid"/>

        <ComboBox x:Name="StatusComboBox"
                  Grid.Row="2"
                  Grid.Column="2"
                  Margin="5,5,5,10"
                  Height="25"
                  DisplayMemberPath="statusname"
                  SelectedValuePath="statusid"/>

        <DatePicker x:Name="OrderDatePicker"
                    Grid.Row="2"
                    Grid.Column="3"
                    Margin="5,5,10,10"
                    Height="25"
                    SelectedDateFormat="Short"/>

        <!-- Дополнительные поля -->
        <Label Content="Время" 
               Grid.Row="3" 
               Grid.Column="0" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,0" 
               FontSize="12"
               VerticalAlignment="Top"
               FontWeight="Bold"/>

        <TextBox x:Name="TimeTextBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 Margin="5,5,5,10"
                 Height="25"
                 VerticalContentAlignment="Center"
                 Text="12:00"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,5,10,10">

            <Button Content="Добавить"
                    Click="AddButton_Click"
                    Width="100"
                    Height="30"
                    Margin="0,0,5,0"/>

            <Button Content="Изменить"
                    Click="UpdateButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Удалить"
                    Click="DeleteButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,5,0"/>

            <Button Content="Обновить"
                    Click="RefreshButton_Click"
                    Width="100"
                    Height="30"
                    Margin="5,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>